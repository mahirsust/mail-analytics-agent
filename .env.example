# ─── Environment ──────────────────────────────────────────────────────────────
AZURE_ENV_NAME=<your-environment-name>             # e.g. dev | prod
AZURE_LOCATION=<your-azure-region>                 # e.g. swedencentral
ENVIRONMENT=<your-environment-name>
LOG_LEVEL=<your-log-level>                         # e.g. INFO | DEBUG

# ─── Azure Tenant & Identity ──────────────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-managed-identity-client-id>
AZURE_CLIENT_SECRET=<your-entra-app-client-secret> # dev only; use managed identity in prod
AZURE_SUBSCRIPTION_ID=<your-subscription-id>

# ─── Resource Names ────────────────────────────────────────────────────────────
AZURE_RESOURCE_GROUP=<your-resource-group-name>
AZURE_MANAGED_IDENTITY_NAME=<your-managed-identity-name>
AZURE_CONTAINER_REGISTRY=<your-container-registry-name>
AZURE_CONTAINER_REGISTRY_SERVER=<your-container-registry-server>  # e.g. <name>.azurecr.io
IMAGE_TAG=<your-image-tag>                         # e.g. latest

# Container Apps
AZURE_CONTAINER_APP_ENV=<your-container-app-environment-name>
AZURE_CONTAINER_APP_AGENT=<your-agent-container-app-name>
AZURE_CONTAINER_APP_WORKER=<your-worker-container-app-name>
AZURE_CONTAINER_APP_ANALYTICS_MCP=<your-analytics-mcp-container-app-name>
AZURE_CONTAINER_APP_JOB_INDEX_SYNC=<your-index-sync-job-name>

# Key Vault
AZURE_KEYVAULT_NAME=<your-keyvault-name>
AZURE_KEYVAULT_URL=<your-keyvault-url>             # e.g. https://<name>.vault.azure.net/

# AI Foundry / OpenAI
AZURE_AI_SERVICES_NAME=<your-ai-services-name>
AZURE_AI_FOUNDRY_ENDPOINT=<your-ai-foundry-endpoint>  # e.g. https://<name>.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-openai-deployment-name> # e.g. gpt-4o
AZURE_OPENAI_API_VERSION=<your-openai-api-version>    # e.g. 2024-12-01-preview

# AI Search
AZURE_SEARCH_NAME=<your-search-service-name>
AZURE_SEARCH_ENDPOINT=<your-search-endpoint>       # e.g. https://<name>.search.windows.net
AZURE_SEARCH_INDEX_NAME=<your-search-index-name>
AZURE_SEARCH_API_KEY=                              # leave blank to use managed identity (recommended in prod)

# Storage
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account-name>
AZURE_STORAGE_QUEUE_NAME=<your-storage-queue-name>
AZURE_STORAGE_CONNECTION_STRING=                   # leave blank to use managed identity (recommended in prod)

# Monitoring
AZURE_LOG_ANALYTICS_NAME=<your-log-analytics-workspace-name>
AZURE_APP_INSIGHTS_NAME=<your-app-insights-name>

# ─── Azure AI Content Safety ──────────────────────────────────────────────────
AZURE_CONTENT_SAFETY_ENDPOINT=<your-content-safety-endpoint>
AZURE_CONTENT_SAFETY_KEY=                          # dev only; use managed identity in prod

# ─── Microsoft Graph / M365 MCP ───────────────────────────────────────────────
# Delegated scopes granted to the Entra app:
#   Mail.ReadWrite  Mail.Send  offline_access  openid  profile
GRAPH_SCOPE=https://graph.microsoft.com/.default
M365_MCP_SERVER_URL=<your-m365-mcp-server-url>    # e.g. http://localhost:3000 for local dev

# ─── Agent host ───────────────────────────────────────────────────────────────
AGENT_HOST_PORT=<your-agent-host-port>             # e.g. 8000
AGENT_SYNC_TIMEOUT_SECONDS=<your-sync-timeout>     # escalate to async after this; e.g. 25
AGENT_MAX_RESULT_ROWS=<your-max-result-rows>        # e.g. 1000

# ─── Application Insights / OpenTelemetry ─────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-app-insights-connection-string>

# ─── Index Sync ───────────────────────────────────────────────────────────────
INDEX_SYNC_LOOKBACK_DAYS=<your-lookback-days>      # how far back to sync on first run; e.g. 90
INDEX_SYNC_BATCH_SIZE=<your-batch-size>            # e.g. 50
INDEX_SYNC_SCHEDULE=<your-sync-cron-schedule>      # UTC cron; e.g. */15 * * * *

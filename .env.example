# ─── Azure Tenant & Identity ──────────────────────────────────────────────────
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=<your-entra-app-client-id>
AZURE_CLIENT_SECRET=<your-entra-app-client-secret>   # dev only; use managed identity in prod

# ─── Azure AI Foundry ─────────────────────────────────────────────────────────
AZURE_AI_FOUNDRY_PROJECT=aif-mail-analytics-agent
AZURE_AI_FOUNDRY_ENDPOINT=https://<foundry-endpoint>.services.ai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ─── Azure AI Search ──────────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://srch-mail-analytics-dev.search.windows.net
AZURE_SEARCH_INDEX_NAME=mail-index
# Leave blank to use managed identity (recommended in prod)
AZURE_SEARCH_API_KEY=

# ─── Azure Key Vault ──────────────────────────────────────────────────────────
AZURE_KEYVAULT_URL=https://kv-mail-analytics-dev.vault.azure.net/

# ─── Azure Storage Queue (async jobs) ────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=stmailanalyticsdev
AZURE_STORAGE_QUEUE_NAME=agent-jobs
# Leave blank to use managed identity (recommended in prod)
AZURE_STORAGE_CONNECTION_STRING=

# ─── Azure AI Content Safety ──────────────────────────────────────────────────
AZURE_CONTENT_SAFETY_ENDPOINT=https://<content-safety>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=                            # dev only; use managed identity in prod

# ─── Microsoft Graph / M365 MCP ───────────────────────────────────────────────
# Delegated scopes granted to the Entra app:
#   Mail.ReadWrite  Mail.Send  offline_access  openid  profile
GRAPH_SCOPE=https://graph.microsoft.com/.default
M365_MCP_SERVER_URL=http://localhost:3000          # local dev; container URL in prod

# ─── Agent host ───────────────────────────────────────────────────────────────
AGENT_HOST_PORT=8000
AGENT_SYNC_TIMEOUT_SECONDS=25                      # escalate to async after this
AGENT_MAX_RESULT_ROWS=1000

# ─── Application Insights / OpenTelemetry ─────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=...

# ─── Index Sync ───────────────────────────────────────────────────────────────
INDEX_SYNC_LOOKBACK_DAYS=90                        # how far back to sync on first run
INDEX_SYNC_BATCH_SIZE=50

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=dev                                    # dev | prod
LOG_LEVEL=INFO
